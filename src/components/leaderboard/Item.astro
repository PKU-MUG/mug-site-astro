---
type Props = { name: string; score: string; rank: number; highlighted?: boolean } // 定义 Props 类型

const { name, score, rank, highlighted }: Props = Astro.props
---

<div class:list={["item text-black/90 dark:text-white/90 flex flex-row items-center justify-between p-4 border-2 border-solid rounded-lg text-left", { "item-highlighted": Boolean(highlighted) }]}>
    <div class="rank font-mono font-bold text-lg text-center mr-2 flex-none">#{rank}</div>
    <div class="name flex-1 text-left text-lg ml-2">{name}</div>
    <div class="score font-mono font-bold text-2xl text-right">{score}</div>
</div>

<style>
    .item {
        border: 2px solid var(--meta-divider);
    }

    .item-highlighted {
        background-color: var(--card-bg);
        border: 2px solid var(--title-active);
    }
</style>
