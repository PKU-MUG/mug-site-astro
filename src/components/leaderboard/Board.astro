---
import Item from './Item.astro'

type DataItem = { name: string; score: string } // 定义单个数据项类型
type Props = { data: DataItem[] } // 定义 Props 类型

const { data }: Props = Astro.props // 接收排行榜数据
---

<div class="board">
    <div class="items">
        {
            data.map((item, index) => (
                <Item name={item.name} score={item.score} rank={index + 1} />
            ))
        }
    </div>
</div>

<style>
    .board {
        padding: 1rem;
    }
    .items {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
</style>
