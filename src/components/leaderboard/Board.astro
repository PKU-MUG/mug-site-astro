---
import Title from '@components/posts/Title.astro'
import Item from './Item.astro'

type DataItem = { name: string; score: string; highlighted?: boolean } // 定义单个数据项类型
type Props = { title: string; data: DataItem[] } // 定义 Props 类型

const { title, data }: Props = Astro.props // 接收排行榜数据
---
<div class="px-4 md:px-0 py-4">
    <div class="flex justify-center mb-4">
        <div class="btn-regular disabled rounded-lg pt-3 px-8 w-max">
            <Title title={title} center />
        </div>
    </div>
    <div class="items flex flex-col gap-4">
        {
            data.map((item, index) => (
                <Item name={item.name} score={item.score} rank={index + 1} highlighted={Boolean(item.highlighted)} />
            ))
        }
    </div>
</div>
