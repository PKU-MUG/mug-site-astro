---
import Board from '@components/leaderboard/Board.astro'
import Title from '@components/posts/Title.astro'
import SimpleGridLayout from '@layouts/SimpleGridLayout.astro'
import csvData from '../../../../data/wmc1st.csv?raw'
import { type Submission, parseCSV } from '../model'

const submissions: Submission[] = parseCSV(csvData)

const leaderboardData = submissions
    .map(({ gameId, group, score }) => ({
        name: gameId,
        group,
        score,
    }))
    .filter(item => item.group === '1')
leaderboardData.sort((a, b) => b.score - a.score)
---

<SimpleGridLayout>
    <Title title="WMC 1st 高难组（A 组）预选赛结果" center />
    <Board
        data={leaderboardData.map(({ name, score }) => ({
            name,
            score: `${score.toFixed(4)}%`,
        }))}
    />
</SimpleGridLayout>
