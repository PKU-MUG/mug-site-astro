---
import Board from '@components/leaderboard/Board.astro'
import SimpleGridLayout from '@layouts/SimpleGridLayout.astro'
import GroupNav from '@components/wmc/GroupNav.astro'
import config, {
    parseWMCCSV,
    dedupeByLastSubmission,
    toLeaderboard,
} from '@/data/wmc/001/config'
import csvRaw from '@/data/wmc/001/data.csv?raw'

const submissions = dedupeByLastSubmission(parseWMCCSV(csvRaw))
const groupSubmissions = submissions.filter(s => s.group === 'C 组')
const leaderboardData = toLeaderboard(groupSubmissions)
---

<SimpleGridLayout title={`${config.title} 预选结果`}>
	<Board
		title={`${config.title} 萌新组（C 组）预选赛结果`}
		data={leaderboardData}
	/>
	<GroupNav edition="wmc-1st" activeGroup="C" groups={config.groups} />
</SimpleGridLayout>
